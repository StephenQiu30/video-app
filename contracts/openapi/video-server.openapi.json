  "components": {
    "schemas": {
      "EmailPasswordRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 320,
            "format": "email",
            "title": "Email",
            "examples": [
              "user@example.com"
            ]
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "EmailPasswordRequest"
      },
      "NativeLogoutRequest": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 1,
            "title": "Refresh Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "title": "NativeLogoutRequest"
      },
      "NativeRefreshRequest": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 1,
            "title": "Refresh Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "title": "NativeRefreshRequest"
      },
      "NativeSessionResponse": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          },
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          },
          "token_type": {
            "type": "string",
            "const": "Bearer",
            "title": "Token Type"
          },
          "access_expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Access Expires At"
          },
          "refresh_expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Refresh Expires At"
          }
        },
        "type": "object",
        "required": [
          "user",
          "access_token",
          "refresh_token",
          "token_type",
          "access_expires_at",
          "refresh_expires_at"
        ],
        "title": "NativeSessionResponse"
      },
      "ProblemDetails": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "description": "稳定的服务错误类型 URI。"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "面向调用方的简短错误标题。"
          },
          "status": {
            "type": "integer",
            "title": "Status",
            "description": "HTTP 状态码。"
          },
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "不包含敏感信息的错误说明。"
          },
          "code": {
            "type": "string",
            "title": "Code",
            "description": "供客户端分支处理的稳定错误码。"
          },
          "instance": {
            "type": "string",
            "title": "Instance",
            "description": "产生错误的请求路径。"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "instance"
        ],
        "title": "ProblemDetails",
        "description": "RFC 9457 error document returned by public API operations."
      },
      "RegisterRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 320,
            "format": "email",
            "title": "Email",
            "examples": [
              "user@example.com"
            ]
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          },
          "username": {
            "type": "string",
            "maxLength": 32,
            "minLength": 2,
            "title": "Username",
            "description": "唯一用户名，支持字母、数字、中文以及 _-. 字符。",
            "examples": [
              "video_user"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password",
          "username"
        ],
        "title": "RegisterRequest"
      },
      "UserResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "username",
          "email",
          "role",
          "created_at",
          "updated_at"
        ],
        "title": "UserResponse"
      },
      "UserRole": {
        "type": "string",
        "enum": [
          "admin",
          "user"
        ],
        "title": "UserRole"
      }
    },
    "securitySchemes": {
      "NativeBearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
