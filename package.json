{
  "name": "video-web",
  "version": "0.0.0",
  "private": true,
  "description": "Ant Design Pro admin console for the video downloader",
  "repository": "https://github.com/StephenQiu30/video-web.git",
  "scripts": {
    "analyze": "cross-env ANALYZE=1 max build",
    "build": "max build",
    "dev": "cross-env PORT=5173 UMI_ENV=dev MOCK=none max dev",
    "start": "cross-env PORT=5173 UMI_ENV=dev MOCK=none max dev",
    "start:no-mock": "cross-env MOCK=none max dev",
    "preview": "max preview --port 8000",
    "preview:build": "max build && max preview --port 8000",
    "lint": "npm run biome:lint && npm run tsc",
    "biome:lint": "biome lint",
    "biome": "biome check --write",
    "openapi": "max openapi",
    "test": "jest --passWithNoTests && node scripts/validate-ant-design-pro-scaffold.mjs && node scripts/validate-auth-openapi-access.mjs && node scripts/validate-user-workspace.mjs",
    "test:update": "jest -u",
    "test:coverage": "jest --coverage",
    "test:e2e": "echo \"E2E will be reintroduced in M4 PR-E (#92)\"",
    "setup": "max setup",
    "tsc": "max setup && tsc --noEmit",
    "docker:up": "docker compose up -d --build web",
    "docker:down": "docker compose down"
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "@ant-design/icons": "^6.2.3",
    "@ant-design/pro-components": "^3.1.12-0",
    "antd": "^6.4.3",
    "antd-style": "^4.1.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@umijs/max": "^4.6.51",
    "@umijs/max-plugin-openapi": "^2.0.3",
    "cross-env": "^10.1.0",
    "jest": "^30.4.1",
    "jest-environment-jsdom": "^30.4.1",
    "swagger-ui-dist": "^5.32.6",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
