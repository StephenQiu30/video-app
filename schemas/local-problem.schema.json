{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stephen-codex.local/schemas/local-problem.schema.json",
  "title": "LocalProblemV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "title", "status", "code", "detail", "request_id"],
  "properties": {
    "type": {"const": "about:blank"},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": [403, 503]},
    "code": {
      "enum": [
        "LOCAL_CONFIGURATION_ERROR",
        "LOCAL_SERVER_UNAVAILABLE",
        "LOCAL_REQUEST_REJECTED"
      ]
    },
    "detail": {"type": "string", "minLength": 1},
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,128}$"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"code": {"const": "LOCAL_REQUEST_REJECTED"}}},
      "then": {"properties": {"status": {"const": 403}}},
      "else": {"properties": {"status": {"const": 503}}}
    }
  ]
}
